# Dependencies
node_modules/

# Package manager and npm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/
.yarn/
.pnp.*

# Build output and bundler caches
dist/
build/
coverage/
.vite/
.cache/
*.tsbuildinfo

# Local environment files
# Keep .env.example (and other checked-in templates) visible to Git.
.env
.env.*
!.env.example
!.env.template
!.env.sample

# Logs and runtime output
logs/
*.log
*.log.*
*.pid
*.pid.lock

# Test and tool caches
.eslintcache
.stylelintcache
.jest-cache/
.turbo/
.nyc_output/

# OS-specific files
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Desktop.ini

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*.swn
*~

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Generated reports and local exports
report.json
*.lcov

# Do not ignore package-lock.json, yarn.lock, or pnpm-lock.yaml:
# dependency lockfiles should be committed for reproducible installs.